DATABASE_URL=sqlite://data/edda.db
# The app itself never reads this — it uses EDDA_DATA_DIR at runtime. This
# is only for the sqlx::query!/query_as! macros at *build* time: forcing
# offline mode makes builds use the committed .sqlx/ cache instead of
# requiring a live, migrated database file to exist on disk. Unset this
# (or override on the command line) when running `cargo sqlx prepare`
# after changing a query.
SQLX_OFFLINE=true

# Everything below is reference only — this file is not loaded at runtime by
# the edda binary itself (only sqlx's build-time macros read DATABASE_URL/
# SQLX_OFFLINE above, via a transitive dotenvy dependency). To actually apply
# any of these, set them in your shell/service environment. See
# .env.example and README.md's "Observability" section for details.

# EDDA_DATA_DIR=./data
# IP=127.0.0.1
# PORT=8080

# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SDK_DISABLED=true
# OTEL_SERVICE_NAME=edda
# OTEL_SERVICE_VERSION=
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.2
# EDDA_LOG_FORMAT=pretty
