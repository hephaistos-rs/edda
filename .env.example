# Edda environment configuration reference.
#
# NOTE on how this file actually gets used: Edda's own binary does NOT load
# `.env` at runtime by itself — every variable below must be set in your
# actual shell/service environment (`export VAR=...`, `docker run -e
# VAR=...`, a systemd `EnvironmentFile=`, docker-compose's `environment:`,
# etc.) for the running server to see it. Copying this file to `.env` is a
# convenient reference/staging step, not something the binary reads directly.
#
# Nothing in this file is secret, but `.env` itself is gitignored anyway (a
# locally-added real secret should never risk being committed by habit).
# First-time setup: `cp .env.example .env`.
#
# Every EDDA_* variable is parsed and validated ONCE at startup
# (`edda_http::config::Settings`). A misconfigured instance stops
# immediately and prints the *complete* list of problems — not one at a
# time. All variables below are optional; unset means the documented
# default. (The OTEL_* / EDDA_LOG_FORMAT block at the end is read by the
# telemetry layer directly, not through Settings.)

# --- Runtime: application ---

# The URL the outside world reaches this instance on (scheme + host +
# optional port, no trailing slash). Anchors the OAuth redirect / WebAuthn
# origin / CSRF-origin defaults. Unset derives `http://<IP>:<PORT>`.
# EDDA_EXTERNAL_URL=https://git.example.com

# Where repo data and the SQLite database live on disk. Only relevant when
# EDDA_DATABASE_URL is unset (the SQLite zero-config default).
# EDDA_DATA_DIR=./data

# Which database backend and instance to connect to — one compiled binary
# supports SQLite, PostgreSQL, and MySQL/MariaDB all as first-class
# backends, selected at runtime by this URL's scheme. Unset falls back to
# a local SQLite file under EDDA_DATA_DIR above — the zero-config default.
# Required (no local default exists) for PostgreSQL/MySQL:
# EDDA_DATABASE_URL=postgres://edda:edda@localhost:5432/eddadb   # matches compose.db.yml
# EDDA_DATABASE_URL=mysql://edda:edda@localhost:3306/eddadb      # matches compose.db.yml

# Address the server binds to. IP is read by both the HTTP server (via
# dioxus_cli_config) and the git-over-SSH listener; PORT is the HTTP port.
# IP=127.0.0.1
# PORT=8080

# Port the git-over-SSH listener binds to (on IP above). Unset defaults to
# 2222. A host key is generated on first start at
# $EDDA_DATA_DIR/ssh_host_ed25519_key and reused thereafter.
# EDDA_SSH_PORT=2222

# --- Runtime: authentication hardening ---

# The AES-256-GCM key used to encrypt recoverable secrets at rest (a
# user's TOTP shared secret; an outgoing webhook's HMAC signing secret) —
# 64 hex characters (32 bytes). Generate one with, e.g.,
# `openssl rand -hex 32`. Optional: unset, the instance starts (with a
# warning) but TOTP (2FA) enrollment and creating webhooks with a stored
# secret are unavailable until it is set — no lazy panic. A malformed
# value is a hard startup error. Must stay the same across restarts —
# rotating it makes every already-enrolled account's 2FA and every stored
# webhook secret unrecoverable (versioned rotation is a later phase; the
# forward-compatible `id:hex,id:hex` form is accepted now, id ignored).
# EDDA_SECRET_KEYS=

# OAuth2/OIDC login against one instance-configured, generic OIDC-compliant
# provider — Edda is a consumer here, never a provider itself. All four
# unset (the default) means OAuth login is simply not offered.
# EDDA_OAUTH_ISSUER_URL=
# EDDA_OAUTH_CLIENT_ID=
# EDDA_OAUTH_CLIENT_SECRET=
# EDDA_OAUTH_REDIRECT_URL=

# WebAuthn / passkey registration and login. Both must be set together, or
# WebAuthn is simply not offered (same both-or-neither shape as OAuth
# above). RP_ID is the registrable domain credentials are scoped to (e.g.
# example.com); ORIGIN is the exact scheme+host(+port) the browser reports
# (e.g. https://example.com). A mismatch on either fails every ceremony.
# EDDA_WEBAUTHN_RP_ID=
# EDDA_WEBAUTHN_ORIGIN=

# --- Runtime: email (password reset, mention notifications) ---

# Outbound SMTP. Both must be set for mail to be sent; unset (the default)
# is a fully supported standalone mode — email-backed jobs log and no-op
# instead of failing, and in-app notifications still work. EDDA_SMTP_URL is
# a lettre connection URL (smtp://, smtps://, or smtp://host:port with
# ?tls=required); EDDA_SMTP_FROM is the envelope/From mailbox.
# EDDA_SMTP_URL=smtp://user:pass@smtp.example.com:587?tls=required
# EDDA_SMTP_FROM=Edda <no-reply@example.com>

# --- Runtime: rate limiting ---

# Per-client token-bucket limits applied to everything under this server's
# API surface *except* the git smart-HTTP bridge and Git LFS (real
# `git`/`git-lfs` traffic is deliberately never throttled). Client identity
# comes from the X-Forwarded-For/X-Real-IP header a reverse proxy sets; a
# direct, unproxied deployment still gets *some* protection (every such
# request shares one bucket) but not full per-client fairness — put a
# reverse proxy in front for that. Defaults (5 requests/second, burst of
# 20) are generous enough for normal interactive use.
# EDDA_RATE_LIMIT_PER_SECOND=5
# EDDA_RATE_LIMIT_BURST=20

# --- Runtime: observability ---
# Structured local logging is always on and needs no configuration. Nothing
# below is required for the app to run normally — see README.md's
# "Observability" section for the full explanation of each variable.

# Setting any *_ENDPOINT below enables OTLP export. Point it at your
# OpenTelemetry Collector, never at a specific backend directly.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=

# Force OTel export off even if an endpoint above is set.
# OTEL_SDK_DISABLED=true

# Resource identity. OTEL_SERVICE_NAME defaults to "edda" when unset.
# OTEL_SERVICE_NAME=edda
# OTEL_SERVICE_VERSION=
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production

# Trace sampling. Defaults when unset: always_on in debug builds,
# parentbased_traceidratio at 0.2 in release builds.
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.2

# pretty|json — defaults to pretty in debug builds, json in release builds.
# EDDA_LOG_FORMAT=pretty
