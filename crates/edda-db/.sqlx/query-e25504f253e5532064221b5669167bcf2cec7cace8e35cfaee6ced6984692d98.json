  "query": "SELECT r.id, r.owner_type, r.owner_id, r.name, r.description, r.visibility\n               FROM repositories r\n               JOIN users u ON u.id = r.owner_id AND r.owner_type = 'user'\n               WHERE LOWER(u.username) = LOWER($1) AND r.name = $2",
