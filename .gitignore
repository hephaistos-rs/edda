# Generated by Cargo
# will have compiled files and executables
/target
.DS_Store
Thumbs.db
desktop.ini

# These are backup files generated by rustfmt
**/*.rs.bk
/data

# Local environment overrides — copy .env.example to .env and edit as
# needed. .env.example stays tracked as the reference; .env itself doesn't,
# so a locally-added secret can never be accidentally committed.
/.env

# Editors
.vscode/
.idea/
*.local.md
