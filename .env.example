# Edda environment configuration reference.
#
# NOTE on how this file actually gets used: Edda's own binary does NOT load
# `.env` at runtime by itself — every variable below must be set in your
# actual shell/service environment (`export VAR=...`, `docker run -e
# VAR=...`, a systemd `EnvironmentFile=`, docker-compose's `environment:`,
# etc.) for the running server to see it. Copying this file to `.env` is a
# convenient reference/staging step, not something the binary reads directly.
#
# Nothing in this file is secret, but `.env` itself is gitignored anyway (a
# locally-added real secret should never risk being committed by habit).
# First-time setup: `cp .env.example .env`.

# --- Runtime: application ---

# Where repo data and the SQLite database live on disk. Only relevant when
# EDDA_DATABASE_URL is unset (the SQLite zero-config default).
# EDDA_DATA_DIR=./data

# Which database backend and instance to connect to — one compiled binary
# supports SQLite, PostgreSQL, and MySQL/MariaDB all as first-class
# backends, selected at runtime by this URL's scheme. Unset falls back to
# a local SQLite file under EDDA_DATA_DIR above — the zero-config default.
# Required (no local default exists) for PostgreSQL/MySQL:
# EDDA_DATABASE_URL=postgres://edda:edda@localhost:5432/eddadb   # matches compose.db.yml
# EDDA_DATABASE_URL=mysql://edda:edda@localhost:3306/eddadb      # matches compose.db.yml

# Address the server binds to (read by dioxus_cli_config).
# IP=127.0.0.1
# PORT=8080

# --- Runtime: authentication hardening ---

# Required before any TOTP (2FA) enrollment or verification can run — 64
# hex characters (32 bytes), the AES-256-GCM key used to encrypt a user's
# TOTP shared secret at rest. Generate one with, e.g., `openssl rand -hex
# 32`. Unlike the LFS transfer-auth token secret (generated randomly at
# each process start), this key must stay the same across restarts —
# rotating it makes every already-enrolled account's 2FA unrecoverable.
# EDDA_SECRET_KEY=

# OAuth2/OIDC login against one instance-configured, generic OIDC-compliant
# provider — Edda is a consumer here, never a provider itself. All four
# unset (the default) means OAuth login is simply not offered.
# EDDA_OAUTH_ISSUER_URL=
# EDDA_OAUTH_CLIENT_ID=
# EDDA_OAUTH_CLIENT_SECRET=
# EDDA_OAUTH_REDIRECT_URL=

# --- Runtime: observability ---
# Structured local logging is always on and needs no configuration. Nothing
# below is required for the app to run normally — see README.md's
# "Observability" section for the full explanation of each variable.

# Setting any *_ENDPOINT below enables OTLP export. Point it at your
# OpenTelemetry Collector, never at a specific backend directly.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=

# Force OTel export off even if an endpoint above is set.
# OTEL_SDK_DISABLED=true

# Resource identity. OTEL_SERVICE_NAME defaults to "edda" when unset.
# OTEL_SERVICE_NAME=edda
# OTEL_SERVICE_VERSION=
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production

# Trace sampling. Defaults when unset: always_on in debug builds,
# parentbased_traceidratio at 0.2 in release builds.
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.2

# pretty|json — defaults to pretty in debug builds, json in release builds.
# EDDA_LOG_FORMAT=pretty
